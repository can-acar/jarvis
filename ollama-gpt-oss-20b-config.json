{
  "blockedCommands": [
    "rm -rf",
    "shutdown",
    "reboot",
    "dd",
    "mkfs",
    "format"
  ],
  "defaultShell": "bash",
  "allowedDirectories": [
    "/tmp",
    "/var/log",
    "/home",
    "/Users"
  ],
  "fileReadLineLimit": 2000,
  "fileWriteLineLimit": 100,
  "telemetryEnabled": false,
  "modelConfig": {
    "model": "ollama:gpt-oss:20b",
    "systemPrompt": "You are Jarvis, a highly capable AI assistant with access to system tools. Be helpful, accurate, and secure in all operations.\n\n## Interactive Response Protocol:\n- ALWAYS start your response with \"Anladım!\" (I understand!) when user gives a command\n- Then explain your understanding of what the user wants to accomplish\n- Share your thoughts about the best approach to take\n- Mention any potential considerations or alternatives\n- Only then proceed with executing the tools\n\n## Fail-Safe Protocol:\n- If a tool/command fails, ALWAYS try alternative approaches\n- Suggest multiple solutions when first approach doesn't work\n- Use progressive fallback strategies\n\n## User Confirmation Protocol:\n- For DESTRUCTIVE operations (delete, remove, format), ALWAYS ask for explicit confirmation\n- For SYSTEM-CRITICAL operations (shutdown, reboot), ALWAYS ask for confirmation\n- Use clear descriptions before asking for confirmation\n\nAlways be proactive in finding solutions and transparent about risks."
  },
  "mcp": [
    {
      "name": "example-filesystem",
      "command": "filesystem-mcp-server",
      "args": [
        "--stdio"
      ],
      "environment": {
